source "https://rubygems.org"

gem "kramdown", ">= 2.5.1"
gem "kramdown-parser-gfm"
gem "minimal-mistakes-jekyll", "~> 4.27"
gem "tzinfo", "~> 2.0"
gem "tzinfo-data"
gem "webrick", ">= 1.8.2"

group :jekyll_plugins do
  gem 'jekyll-include-cache'
  gem 'jekyll-feed', '>= 0.15.1'
  gem 'jekyll-sitemap'
  gem 'jekyll-paginate'
  gem 'jekyll-seo-tag', '>= 2.7.0'
end

